# 复制为 .env 并填入真实值（.env 不入 git，见 .gitignore）

# ── 免 key 数据源：无需任何配置 ──────────────────────────
#   商店搜索枚举 / Steam appdetails / 全局成就完成率 / Steam 社区成就页 / SteamSpy

# ── Steam Web API key（用于 IStoreService/GetAppList）──────────────
# 免费申请：https://steamcommunity.com/dev/apikey
# 用途**仅限**读公开商店条目列表（拿无漂移的全量 appid 全集）。项目不需要任何
# 逐玩家数据，所以这不违反「只用公开数据源」。
# 没有它也能跑：只是商店搜索会因排序漂移漏掉约 15% 的游戏。
STEAM_API_KEY=

# ── RAWG（评分 / 时长 / 弃坑率 / 题材标签）──────────────────
# 注册后获取：https://rawg.io/apidocs
# ⚠️ 多机并行时**不要**用这个变量分发 key——RAWG 配额按 key 计，各机器读本地
#    .env 就无法协调额度。正确做法是入库到共享的密钥池：
#      uv run python -m cleaning.rawg_keys add --key <KEY> --label <谁的>
#    这里的值只在「密钥池为空」时作为单机回退使用。
RAWG_API_KEY=

# ── 数据库（**必填**，2026-09-17 起不再有本地 Docker 缺省）────────────
# 所有机器连**同一个**云库，任务队列 / 配额账本 / RAWG 密钥池都在那里。
# 这也是多机并行的前提：worker 的原子抢占靠库里的行锁实现。
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DB=achievement_analytics
POSTGRES_USER=
POSTGRES_PASSWORD=
# 腾讯云等托管 PG 一般强制 SSL；本机自建库可留空
POSTGRES_SSLMODE=require
