# 复制为 .env 并填入真实值（.env 不入 git，见 .gitignore）

# ── 免 key 数据源：无需任何配置 ──────────────────────────
#   Steam 商店 appdetails / 全局成就完成率 / Steam 社区成就页 / SteamSpy

# ── RAWG（本项唯一需要 key 的数据源）────────────────────
# 注册后获取：https://rawg.io/apidocs
RAWG_API_KEY=

# ── 数据库（可选）───────────────────────────────────────
# 缺省值与 docker-compose.yml 一致，本机开发**不需要**配置这里；
# 队友要连远程库 / 换端口时才取消注释覆盖。
#POSTGRES_HOST=localhost
#POSTGRES_PORT=5433
#POSTGRES_DB=achievement_analytics
#POSTGRES_USER=analyst
#POSTGRES_PASSWORD=analyst_dev_pw
