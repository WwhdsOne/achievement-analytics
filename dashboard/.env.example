# 面板部署账号；仅本机部署脚本使用，不上传到服务器
DEPLOY_HOST=82.157.208.173
DEPLOY_USER=root
DEPLOY_PASSWORD=
DEPLOY_PATH=/opt/achievement-dashboard
DEPLOY_PORT=8600

# 面板和推荐服务运行时的数据库地址（同机 host 网络）
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
POSTGRES_DB=achievement_analytics
POSTGRES_USER=
POSTGRES_PASSWORD=

# Go 面板连接推荐服务；同机部署无需额外开放端口
RECOMMENDATION_HOST=127.0.0.1
RECOMMENDATION_PORT=8605

# 数据下载：由面板自己的 .env 读取。
# 密钥只注入服务器运行时 env，不进入前端与镜像。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Linux 打包时可指定 CA_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

# 推荐服务独立部署目录与监听地址
RECOMMENDATION_DEPLOY_PATH=/opt/achievement-recommendation
RECOMMENDATION_BIND_HOST=127.0.0.1
# DeepSeek 配置默认只从本机 result/WWH/5/.env 读取，密钥仅注入推荐容器
# RECOMMENDATION_DEEPSEEK_ENV_FILE=/absolute/path/to/deepseek.env
# 可选：推荐服务部署在另一台机器时，单独覆盖部署凭据
# RECOMMENDATION_DEPLOY_HOST=
# RECOMMENDATION_DEPLOY_USER=
# RECOMMENDATION_DEPLOY_PASSWORD=
