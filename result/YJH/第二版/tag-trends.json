  "taxonomy": {
    "version": "2026-10-16.1",
    "main_dimension": "类型与子类型",
    "dimension_order": [
      "类型与子类型",
      "机制与特色",
      "题材设定",
      "美术与呈现",
      "玩家模式与支持",
      "制作与发行属性",
      "氛围与叙事",
      "其他",
      "非游戏标签"
    ],
    "rules": [
      "同一标签只归一个维度，冲突在导入时直接报错。",
      "类型与子类型只收回答「这是什么游戏」的玩法门类与子类型。",
      "程序生成、编辑器、自定义、模组、建造、自动化等机制归「机制与特色」。",
      "Indie、抢先体验、免费、众筹、引擎工具等归「制作与发行属性」，描述发行形态而非玩法。",
      "交叉语义标签按「对分析问题最有解释力的那一面」归类。"
    ],
    "crosswalk_notes": {
      "Indie": "官方 valve_genres 也把它列为类型，但它描述的是制作/发行身份而非玩法，会与「独立」绑定的整体规模共振，故归「制作与发行属性」，并在对照图中说明。",
      "Early Access / Free to Play": "商业发行形态，归「制作与发行属性」；与游戏玩法结构无关。",
      "Exploration": "原映射缺失、落到「其他」；它是玩法活动而非玩法门类，归「机制与特色」。",
      "Dice / Time Attack / Score Attack / Boss Rush": "挑战与判定机制，归「机制与特色」，不归类型。",
      "Time Management / Management": "Steam 官方把它们当作玩法门类（休闲管理类游戏），故留在「类型与子类型」；而同族的 Resource / Inventory Management 是机制，归「机制与特色」。",
      "Farming / Agriculture": "作为玩法门类（农作模拟）归「类型与子类型」。",
      "Gambling / Cooking / Nature / Futuristic": "题材设定，归「题材设定」。",
      "RPGMaker / GameMaker": "引擎与制作工具标记，归「制作与发行属性」。",
      "Foreign / Local Multiplayer": "本地化与联机支持功能，归「玩家模式与支持」。"
    },
