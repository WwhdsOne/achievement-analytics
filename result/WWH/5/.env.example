# WWH 第 5 项专用配置。复制到同目录 .env，不放到项目根目录。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# PostgreSQL 只作为首次只读导入来源。
