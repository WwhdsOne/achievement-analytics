# 本地数据、流水线日志与运行报告；SQL、说明和程序可以跟踪。
database/*.sqlite*
database/*.db*
process/runtime/
process/__pycache__/
# 数据库目录仅保留两份固定选样 JSON，其余内容继续忽略。
/database/*
!/database/data/
/database/data/*
!/database/data/top1000_appids.json
!/database/data/top1000_selection.json
# 借用的WWH快照与锁文件，保持本地只读，不提交原始数据。
/NewDB/*.sqlite*
/NewDB/*.db*
